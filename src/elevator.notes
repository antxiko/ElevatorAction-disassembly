D 0x5E5E 0x5E8B escalera_pasos    La X de cada paso de los 4 tramos de escalera (7 pasos)

# ---------------------------------------------------------------- los ascensores
# 11 ascensores de 10 bytes en 0xC0EC: +0 bits (0 subiendo, 1 techo ocupado, 3 lleva enemigo, 4 en marcha,
# 5 el que baja al sotano, 6 doble: dos cabinas a 12 filas, 7 lleva al agente), +1 columna, +2 fila de la cabina,
# +3/+4 su sitio en el mapa, +5 fila de arriba del recorrido, +6 la de abajo. Temporizadores 1 a 11.
B 0x5E8B =====  Los ascensores  =====
L 0x5E8B ascensores_cuadro         Mueve los 11 ascensores: los que estan cerca de la vista van y vienen solos
C 0x5E8B los 11
L 0x5E91 ascensor_uno
C 0x5E92 con el techo ocupado no se mueve
C 0x5E99 su temporizador
C 0x5EA2 su fila...
C 0x5EA5 ...la de la segunda cabina, si es doble
C 0x5EAD respecto a la vista
C 0x5EB3 por encima: quieto
C 0x5EB5 menos de 13 filas: hacia abajo
L 0x5EBF ascensor_lejos
C 0x5EC9 a menos de 48 filas: sigue
C 0x5ECD de 48 a 72: hacia arriba
L 0x5ED3 ascensor_sube_ya
L 0x5ED9 ascensor_fuera
C 0x5EDB el ascensor 0 (el de la azotea) se mueve siempre
L 0x5EE0 ascensor_extremos         En la fila de arriba del recorrido cambia a bajar; en la de abajo, a subir
C 0x5EE3 arriba del todo?
C 0x5EE8 abajo del todo?
L 0x5EF8 ascensor_arriba
L 0x5F01 ascensor_gira
C 0x5F01 lleva al agente...
C 0x5F07 ...y en marcha: lo decide el
L 0x5F0D ascensor_guarda
L 0x5F10 ascensor_mueve
C 0x5F10 lleva al agente?
C 0x5F16 no: una fila
L 0x5F1B ascensor_mueve_vista      Con el agente dentro, lo que se mueve es la vista (bit 6 de 0xC0D0)
L 0x5F28 ascensor_vista_baja
L 0x5F2A ascensor_vista
L 0x5F2F ascensor_parada           En una planta (suelo 0x60 o tejado al lado) espera 120 cuadros; si no, 20 por fila
C 0x5F2F su sitio en el mapa
C 0x5F35 la columna de su izquierda
C 0x5F3C con el agente, una fila mas abajo...
C 0x5F46 ...o una mas arriba si sube
C 0x5F4B en marcha a mano: sin parada
L 0x5F51 ascensor_mira_planta
L 0x5F5A ascensor_espera_planta
L 0x5F5E ascensor_espera_fila
L 0x5F60 ascensor_espera
L 0x5F67 ascensor_sig
L 0x5F72 ascensor_una_fila         Sube o baja la cabina IX una fila y la vuelve a pintar en el mapa
C 0x5F75 el mapa se vuelca despues
C 0x5F78 sube?
C 0x5F7E con un enemigo dentro...
C 0x5F84 ...8 arriba
C 0x5F89 fila - 1
C 0x5F90 su sitio en el mapa
C 0x5F99 la cabina
C 0x5F9C doble: las dos
C 0x5FA8 debajo del suelo...
C 0x5FB1 ...el hueco
L 0x5FB9 ascensor_baja_fila
C 0x5FBF un enemigo dentro: 8 abajo
C 0x5FC4 fila + 1
C 0x5FD4 la de encima...
C 0x5FDA ...salvo arriba del recorrido...
L 0x5FE3 ascensor_cable
C 0x5FE7 ...es cable
L 0x5FED ascensor_pinta_cabina
C 0x5FFC el del sotano...
C 0x6002 ...en lo mas bajo...
C 0x600A ...5 filas mas abajo...
C 0x6017 ...el suelo del sotano
L 0x6014 ascensor_sotano
L 0x601D ascensor_pintado
C 0x601D un tile fijo del sotano (0xCF6F = 0x68)
C 0x6022 volcar en el proximo cuadro
L 0x6026 enemigo_del_ascensor      Suma A a la Y del enemigo que va en el ascensor
L 0x603C sitio_en_mapa             DE = 0xC400 + (A + 8) x 32 + la columna de IX
L 0x604D fila_por_32               HL = (A + 8) x 32
L 0x6055 fila_por_32_sig
L 0x605A ascensores_nuevos         Los 11 ascensores de la tabla 0x60DB; uno al azar de los cinco ultimos baja al sotano
C 0x605A uno de 5 al azar
C 0x6064 la tabla
L 0x6069 ascensor_nuevo
C 0x606D fila de arriba
C 0x6072 fila de abajo
C 0x6077 columna
C 0x607C fila de salida
C 0x6085 120 cuadros antes de moverse
C 0x608B de los cinco ultimos...
C 0x6090 ...3 de cada 10...
C 0x6099 ...son dobles
C 0x609D y su recorrido 12 filas mas corto
L 0x60A5 ascensor_sotano_azar
C 0x60A5 el elegido...
C 0x60A9 ...baja al sotano
L 0x60B0 ascensor_nuevo_sig
L 0x60B8 ascensor_hasta_sotano     El recorrido se alarga una planta (6 filas) y se pinta el hueco
C 0x60BD 6 filas mas
C 0x60CE seis filas de hueco
L 0x60CA ascensor_hasta_sotano_d
L 0x60D0 ascensor_hueco_fila
D 0x60DB 0x6107 ascensores_tabla  Los 11 ascensores: fila de arriba, de abajo, columna y fila de salida
D 0x6107 0x610C tira_cable        "hueco, cable, hueco" (0x2D 0x28 0x2D)
D 0x610C 0x6123 tira_cabina       La cabina, 3 tiles de ancho (primer byte): techo 0x60, el hueco de dentro 0x3B y suelo 0x60; 0xFF acaba
D 0x6123 0x6128 tira_hueco        Tres tiles de hueco (0x2D)
D 0x6128 0x6163 tira_doble        Las dos cabinas del ascensor doble con el cable entre ellas
D 0x6163 0x6168 tira_sotano       El suelo del hueco en el sotano (0x6B)

# ---------------------------------------------------------------- los enemigos
# 4 enemigos de 10 bytes en 0xC2E0: +0 bits (0 en juego, 1 en un ascensor, 2 en la escalera, 4 acaba de disparar,
# 6 muriendo, 7 mira a la izquierda), +1 X, +2 Y, +3 postura (1 de pie, 2 andando, 4 agachado, 8 saltando,
# 0x10 saliendo de una puerta, 0x20/0x40/0x80 muertes), +4 cuadro, +5/+6 dibujos, +7/+8 su puerta o ascensor.
# Temporizadores: 0x15 el de salida de enemigos, 0x16-0x19 uno por enemigo.
B 0x6168 =====  Los enemigos  =====
L 0x6168 enemigos_cuadro           Los 4 enemigos: los que no estan en juego pueden salir por una puerta
C 0x6168 los 4
L 0x616E enemigo_uno
C 0x616E su numero, para la escalera
C 0x6175 en juego?
C 0x617B salidas cortadas?
C 0x6183 el temporizador de salida...
C 0x618C ...cada 60 cuadros...
C 0x6192 ...y la dificultad: 0xC327 cuentas de espera
L 0x619F enemigo_sale              Sale un enemigo por una puerta azul al azar cerca del agente
C 0x619F la cuenta vuelve a empezar
C 0x61A7 su temporizador...
C 0x61AB ...30 cuadros
C 0x61B0 una de 6 puertas
C 0x61B5 libre y en pantalla?
C 0x61BB en juego
C 0x61BF la puerta...
C 0x61C5 ...en la pantalla
C 0x61CC mira a la izquierda?
L 0x61D9 enemigo_sale_der
L 0x61DB enemigo_sale_sitio
C 0x61DB a pixeles
C 0x61E4 saliendo de la puerta
C 0x61EC su puerta
L 0x61F8 enemigo_en_juego
C 0x61FD en la escalera...
C 0x6203 ...con el agente tambien en ella
L 0x6210 enemigo_mueve             Un paso cada 10 cuadros segun lo que este haciendo
