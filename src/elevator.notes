C 0x56E4 el ascensor
C 0x56F2 parado (bit 4)
L 0x56F6 ascensor_baja
C 0x56F6 bit 0 = 0: baja
L 0x56FA ascensor_sube
C 0x56FA bit 0 = 1: sube
L 0x56FC ascensor_marcha
C 0x56FC en marcha
C 0x56FE su numero...
L 0x5709 ascensor_numero
L 0x5712 ascensor_espera_max
C 0x5712 ...es su temporizador
C 0x5716 mas de 20 cuadros?
C 0x571B se deja en 20
L 0x5720 mueve_ascensor_fin
B 0x5721 =====  Los sprites de una ficha  =====
L 0x5721 pon_sprites               Pone en el buffer (IY) los B sprites de IX segun postura y cuadro; fuera de pantalla los esconde y C=1
C 0x5724 la tabla de dibujos
C 0x572A la postura: un bit
L 0x572D pon_sprites_postura
C 0x572D el bit que esta a 1...
C 0x5731 ...dice la entrada
L 0x5735 pon_sprites_lista
C 0x5735 la lista de cuadros de esa postura
C 0x5739 el cuadro
L 0x573C pon_sprites_cuadro
L 0x5743 pon_sprites_cuadro_ya
C 0x5747 X
C 0x574A Y
C 0x574E dentro
C 0x5750 por encima de la Y 0x28 (el marcador)...
C 0x5754 ...por debajo de 0xB9...
C 0x5758 ...o en la X 0xF8 y mas...
L 0x575D pon_sprites_fuera         Fuera de pantalla: la ficha se apaga y, si es un enemigo de una puerta, la puerta queda libre
C 0x575D fuera
C 0x575F se apaga
C 0x5763 en un ascensor: nada mas
C 0x5769 de donde salio
C 0x576F de una puerta?
C 0x577C una de la tabla de puertas?
C 0x5790 la puerta se cierra
L 0x5795 pon_sprites_fuera_fin
L 0x579C pon_sprites_uno           Cada sprite: dibujo, color y desplazamiento de la Y; 0xFF acaba
C 0x579D fin de la lista
C 0x57A1 el dibujo
C 0x57A6 el color
C 0x57A9 la X
C 0x57AD la Y + desplazamiento
C 0x57BD sobran sprites?
L 0x57C2 pon_sprites_esconde
L 0x57C7 pon_sprites_fin
L 0x57CD que_hay_debajo            Busca suelo (0x60, 0x0A tejado, 0x78 escalera) hasta 3 filas bajo los pies: 0 a ras (encaja la Y), 1 un escalon, 2 nada
C 0x57D0 tres filas
C 0x57D5 donde esta
L 0x57D8 debajo_fila
C 0x57DB suelo
C 0x57DF tejado
C 0x57E3 arriba de la escalera
C 0x57E7 la fila siguiente
C 0x57EA nada: 2
L 0x57EE debajo_suelo
C 0x57EE filas bajadas x 8...
C 0x57F7 ...a la Y
C 0x57FD en la ultima fila?
L 0x5805 debajo_escalon
L 0x5807 debajo_fin
L 0x580C esconde_sprite            Pone a cero el sprite IY, salvo si es de un enemigo escondido tras una puerta (bit 2)
C 0x5810 los sprites 3 a 10...
C 0x5819 ...son los de los enemigos
L 0x5823 esconde_sprite_busca
L 0x5830 esconde_sprite_enemigo
C 0x5830 tras la puerta: se deja
L 0x5837 esconde_sprite_cero
L 0x5845 esconde_sprite_sig
D 0x584E 0x5856 agente_disparo    Dibujos del agente disparando (por postura)
D 0x5856 0x58A6 agente_dibujos    Tabla de dibujos del agente: una lista por postura y en cada una un puntero por cuadro
D 0x58A6 0x5928 agente_cuadros    Los cuadros: por sprite dibujo, color y desplazamiento de la Y; 0xFF acaba
D 0x5928 0x5930 txt_500           "500": lo que aparece en la puerta roja al coger los documentos

# ---------------------------------------------------------------- las escaleras mecanicas
# Solo hay escaleras en las plantas cuya fila / 6 va de 11 a 15. Cada tramo se sube o se baja en 7 pasos de 8
# pixeles; el que la usa (agente o enemigo) lleva su cuenta en 0xC38B (3 bytes por usuario, 0xC397 cuantos).
# Las tablas de 0x5E5E dan la X de cada paso: e = 1 y 2 bajan (a la derecha y a la izquierda), 3 y 4 suben.
B 0x5930 =====  Las escaleras mecanicas  =====
L 0x5930 agente_escalera           De pie al pie de una escalera y pulsando arriba o abajo: se sube a ella
C 0x5931 de pie?
C 0x5937 el mando
C 0x593F arriba
C 0x5943 abajo
C 0x5947 0xFF: abajo
L 0x594B agente_escalera_arriba
L 0x594C agente_escalera_planta
C 0x594D la fila del scroll...
C 0x5951 ...entre 6: la planta
C 0x5957 de la 11...
C 0x595B ...a la 15
C 0x5969 las de bajar
C 0x596E o las de subir
L 0x5975 agente_escalera_11
L 0x597C agente_escalera_14
L 0x5988 agente_escalera_15
L 0x598D agente_escalera_no
L 0x5990 agente_escalera_hay       La escalera tiene que ir hacia donde se pulsa
C 0x5992 arriba: solo las de subir (C = 0xFF)
L 0x5999 agente_escalera_baja
L 0x599C agente_escalera_sube_a
L 0x59A7 agente_escalera_x
C 0x59AB en el borde izquierdo
L 0x59B1 agente_escalera_x2
C 0x59B5 en el borde derecho
L 0x59B9 agente_escalera_lado
L 0x59BD agente_escalera_izq
L 0x59C3 agente_escalera_der
L 0x59C7 agente_escalera_empieza
C 0x59CA bit 2: en la escalera
C 0x59CE el tramo
C 0x59D2 un paso cada 2 cuadros
C 0x59D7 paso 0
C 0x59DC la X del primer paso
C 0x59E2 el agente sin un sprite
C 0x59E6 bajando: el scroll sigue
C 0x59EB el sonido de la escalera
C 0x59F4 los enemigos que van detras
C 0x59FC el agente se ha movido
L 0x5A02 escalera_bajar_aqui       Z si la X del agente es la de arriba de una escalera de bajar (C=0)
C 0x5A04 tramo 1
C 0x5A0C mirando a la izquierda?
L 0x5A1A escalera_bajar_i
L 0x5A20 escalera_bajar_2
L 0x5A26 escalera_bajar_tramo_2
C 0x5A26 tramo 2
L 0x5A3C escalera_bajar_d
L 0x5A42 escalera_bajar_ultima
L 0x5A48 escalera_subir_aqui       Z si la X es la de abajo de una escalera de subir (C=0xFF)
C 0x5A4A tramo 4
L 0x5A60 escalera_subir_d
L 0x5A66 escalera_subir_tramo_3
C 0x5A66 tramo 3
D 0x5A78 0x5A79 escalera_ret     Un "ret" (0xC9) que el salto de 0x5A72 se salta: 0x5A72 va a 0x5A79 y 0x5A76 a 0x5A85
L 0x5A79 escalera_subir_ultima
L 0x5A7D escalera_bajar_planta14   Planta 14: solo la de bajar del tramo 2
L 0x5A81 escalera_subir_planta15   Planta 15: solo la de subir del tramo 3
L 0x5A85 x_es                      Z si la X de IX es B
D 0x5A8A 0x5A8C sin_uso_and_ret  Dos bytes que nada alcanza: "and a / ret"
L 0x5A8C agente_en_escalera        Un paso de la escalera cada 2 cuadros: 7 pasos, el agente medio escondido tras el pasamanos
C 0x5A8C la cuenta de cuadros
C 0x5A91 el agente se ha movido
C 0x5A96 otros 2 cuadros
C 0x5A98 el tramo
C 0x5A9C paso siguiente
C 0x5AA0 subiendo?
L 0x5AB9 agente_escalera_sube_paso
L 0x5ACD escalera_pies_fuera       Paso 2: los tres sprites del agente sin dibujo (las piernas tras el escalon)
L 0x5AD2 escalera_pies_sig
L 0x5ADD escalera_paso_1
L 0x5AE0 escalera_paso
L 0x5AE8 escalera_x_del_paso       B = la X del paso E de la tabla HL, y los dos sprites del agente ahi
L 0x5AEF escalera_paso_2b
L 0x5AF4 escalera_paso_3
L 0x5AF9 escalera_paso_4
L 0x5AFE escalera_paso_5
L 0x5B03 escalera_paso_6           Paso 6: el agente vuelve a tener piernas; los enemigos que bajaban detras siguen
C 0x5B03 el scroll ya no sigue
C 0x5B08 los tres sprites
L 0x5B21 escalera_fin              Paso 7: fuera de la escalera, de pie y mirando hacia donde salio
C 0x5B2C bit 2 fuera
C 0x5B3A la X final
C 0x5B3E los dibujos de siempre
C 0x5B48 de pie
C 0x5B50 subiendo, mira segun el tramo
L 0x5B5C escalera_fin_izq
L 0x5B60 escalera_fin_lado
L 0x5B63 escalera_scroll           El scroll sigue al agente: 0x64 filas bajando o 0x75 subiendo
C 0x5B66 bit 6: scroll de escalera
C 0x5B68 bajando?
C 0x5B70 bit 0 = 0
L 0x5B74 escalera_scroll_sube
L 0x5B78 escalera_scroll_guarda
L 0x5B7D agente_dos_sprites        Los dos primeros sprites del agente en la X B (cabeza y cuerpo, dibujos 4 y 8)
C 0x5B80 la Y del primero
C 0x5B8B la del segundo, 9 mas abajo
L 0x5B98 agente_tres_sprites       Los tres sprites del agente en la X B: dibujos 4, 8 y 0x0C
L 0x5BC3 sprite_sin_dibujo         El dibujo del sprite siguiente (HL+2) a cero
L 0x5BC8 enemigo_escalera          Un enemigo al pie de una escalera, si va en la direccion buena, se sube
C 0x5BC9 de pie o andando?
C 0x5BD1 hay escalera?
C 0x5BD7 de las de subir?
L 0x5BE8 enemigo_escalera_baja
L 0x5BF3 enemigo_escalera_sube
C 0x5BF5 su cuenta
C 0x5BFA la X del primer paso
C 0x5C02 sus sprites
C 0x5C06 bajando...
C 0x5C0C ...8 mas abajo
L 0x5C0F enemigo_escalera_pon
C 0x5C10 los pies, 24 por debajo
C 0x5C1C cuerpo segun el lado
L 0x5C24 enemigo_escalera_der
L 0x5C26 enemigo_escalera_color
C 0x5C27 color azul
C 0x5C2C el tercer sprite sin dibujo
C 0x5C2E de pie
C 0x5C3A los dibujos de la escalera
L 0x5C45 enemigo_escalera_der2
L 0x5C4E enemigo_escalera_sonido
C 0x5C4E el sonido de la escalera
D 0x5C57 0x5C78 enemigo_escalera_dib  Dibujos del enemigo en la escalera (tres posturas)
L 0x5C78 cuenta_escalera_nueva     Apunta a IX en la escalera: tramo E, paso 0, 2 cuadros
L 0x5C8B cuenta_escalera           IY = la cuenta de escalera numero 0xC397 (3 bytes cada una)
L 0x5C95 cuenta_escalera_sig
L 0x5C9C hay_escalera              Z si IX esta al pie de una escalera de esta planta (en la Y 0x78, o una planta arriba o abajo)
C 0x5C9C la planta del scroll
C 0x5CA8 solo en filas multiplo de 6
C 0x5CAA en la planta del agente?
C 0x5CB3 una planta abajo
L 0x5CB9 hay_escalera_arriba
L 0x5CBD hay_escalera_planta
L 0x5CD8 hay_escalera_14
L 0x5CDF hay_escalera_15
L 0x5CE2 hay_escalera_no
L 0x5CE6 enemigo_escalera_no
L 0x5CE9 enemigo_en_escalera       Un paso de la escalera del enemigo; si el agente va en ella, al mismo ritmo
C 0x5CEC su cuenta
C 0x5CF2 el agente en la escalera?
C 0x5CF6 se mueve con el
L 0x5CFF enemigo_escalera_cuenta
C 0x5CFF cada 2 cuadros
L 0x5D09 enemigo_escalera_paso
C 0x5D09 paso siguiente
C 0x5D0F el tramo
L 0x5D30 enemigo_escalera_sube_p
L 0x5D44 enemigo_escalera_baja8    Paso 2: 8 pixeles arriba o abajo y sin piernas
L 0x5D4E enemigo_escalera_mas8
L 0x5D50 enemigo_escalera_y
L 0x5D67 enemigo_paso_1
L 0x5D6C enemigo_paso_2b
L 0x5D71 enemigo_paso_3
L 0x5D76 enemigo_paso_4
L 0x5D7B enemigo_paso_5
L 0x5D80 enemigo_paso_6
L 0x5D88 enemigo_escalera_fin      Fin: fuera de la escalera; espera 10 cuadros
C 0x5D8E bit 2 fuera
C 0x5D97 la cuenta libre
C 0x5DA7 10 cuadros
L 0x5DAC enemigo_escalera_ret
L 0x5DAE enemigo_escalera_x        La X del paso, los dibujos y la Y (8 arriba o abajo)
L 0x5DC7 enemigo_escalera_x_d
L 0x5DD0 enemigo_escalera_x_y
L 0x5DDB enemigo_escalera_x_mas
L 0x5DDD enemigo_escalera_x_pon
L 0x5DF3 enemigo_escalera_x_d2
L 0x5DF5 enemigo_escalera_x_col
L 0x5DF9 enemigo_escalera_piernas  Pasos 6 y 7: el enemigo entero otra vez (dibujos 0x58 y 0x5C)
L 0x5E11 enemigo_escalera_pies
L 0x5E40 enemigo_escalera_der3
L 0x5E43 enemigo_escalera_dib_pon
L 0x5E4B enemigo_escalera_sale
