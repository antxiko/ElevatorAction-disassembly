# ---------------------------------------------------------------- el sonido y el final del cartucho
D 0x9ABB 0x9AF0 efectos_fichas    19 efectos: prioridad y donde empiezan sus notas (3 bytes)
D 0x9AF0 0x9AF4 musica_canales    La unica musica: sus canales B y C (el C a cero: solo suena uno)
D 0x9AF4 0x9D9A efectos_notas     Las notas de los efectos: 9 bytes por nota (mezclador, vibrato, tono, volumen, envolvente, ruido, velocidad y duracion); 0x8n repite, 0xC0 acaba
D 0x9D9A 0xA2F0 musica_notas      Las 151 notas de la musica de fondo, con sus repeticiones
D 0xA2F0 0xB2EF copia_de_la_ram   Restos: una copia de la RAM del MSX de 0xF001 a 0xFFFF que se colo al grabar el cartucho (los ganchos, todos "ret", caen en 0xFD9A; las rutinas de slot, en 0xF380; las teclas de funcion "color", "auto", "goto", en 0xF87F)
D 0xB2EF 0xB400 ceros             Ceros
D 0xB400 0xC000 relleno_ff        Relleno: 0xFF hasta el final
C 0x4E80 sus sprites, los primeros del buffer
C 0x4E94 cuadro 1
C 0x4E98 tres sprites
C 0x4E9D puestos
C 0x4EA3 los dos sprites fijos...
C 0x4EA6 ...a los sprites 30 y 31
C 0x4EA9 8 bytes
C 0x4EAC copiados
C 0x4EAE listo
C 0x4EB7 se guarda A
C 0x4EB9 0xC39A a cero
C 0x4EBC A otra vez
C 0x4EC9 no: nada
C 0x4ED1 si: nada
C 0x4ED6 7 cuadros
C 0x4ED8 puesto
C 0x4EDB los bits
C 0x4EE0 si
C 0x4EE4 si
C 0x4EE9 si
C 0x4EEE si
C 0x4EF4 se ha subido?
C 0x4EF5 si: listo
C 0x4EFB 14 cuadros
C 0x4EFD puesto
C 0x4F00 la postura
C 0x4F05 si
C 0x4F09 si
C 0x4F0D si
C 0x4F0F ninguna: nada
C 0x4F12 cuadro + 1
C 0x4F18 el quinto?
C 0x4F1A antes: sigue cayendo
C 0x4F1C despues: fuera
C 0x4F1E el quinto: quieto
C 0x4F26 nada debajo: cae
C 0x4F2C pintado
C 0x4F31 + 16
C 0x4F34 guardada
C 0x4F37 pintado
C 0x4F3A cuadro + 1
C 0x4F3D cual?
C 0x4F40 el noveno?
C 0x4F42 antes: sigue
C 0x4F45 despues: fuera
C 0x4F48 sin el bit de aplastado
C 0x4F4A habia otro?
C 0x4F51 cuadro 1
C 0x4F57 no
